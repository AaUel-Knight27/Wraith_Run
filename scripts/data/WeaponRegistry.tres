[sub_resource type="Resource" id="WeaponData_shotgun"]
script = ExtResource("2_weapon")
WeaponName = "Shotgun"
WeaponClass = "Shotgun"
Description = "Pump-action, eight pellets per shot. Devastating up close, weak at range. Loads one shell at a time and can be interrupted."
FireMode = 1
BodyDamage = 14.0
HeadshotDamage = 26.0
FireRateRPM = 60.0
MagazineSize = 6
MaxReserveAmmo = 24
ReloadTime = 0.5
RecoilVertical = 6.0
RecoilHorizontal = 2.5
RecoilRecoveryMs = 400.0
ModelScenePath = "res://art/weapons/Shotgun/Benelli_M4_gun.fbx"
GripPosition = Vector3(-0.075, 0.19, 0.02)
GripRotationDegrees = Vector3(180, 0, -90)
ModelScale = 1.0
MuzzleDistance = 0.56
PelletsPerShot = 8
SpreadDegrees = 4.5
ShellByShellReload = true
; The pack's "benelli" folder (a real Benelli M4, the same gun this weapon's own model is) has no
; fire clips, only the pump/shell sounds - reload below uses those. The blast itself has no
; shotgun-specific clip anywhere in the pack, so this borrows three of the heavier generic shots.
FireSounds = PackedStringArray("res://audio/SFX/weapons/generic/fire_05.wav", "res://audio/SFX/weapons/generic/fire_15.wav", "res://audio/SFX/weapons/generic/fire_29.wav")
ReloadSounds = PackedStringArray("res://audio/SFX/weapons/benelli/shell_in_01.wav", "res://audio/SFX/weapons/benelli/shell_in_02.wav")
ImpactSounds = PackedStringArray("res://audio/SFX/explosions/explosion.wav")
EmptySound = "res://audio/SFX/weapons/shared/bolt_open.wav"
FireAudioUnitSize = 7.5
FireVolumeDb = 2.0
FireMaxDistanceMeters = 90.0
FireEmissionAngleDegrees = 75.0
FireEmissionOffAxisAttenuationDb = -6.0
FireCanDuckMovement = true
FireReportDelayEnabled = true

; Reserved weapon definitions can be restored here later.
[resource]
script = ExtResource("1_registry")
Weapons = Array[ExtResource("2_weapon")]([SubResource("WeaponData_ak47"), SubResource("WeaponData_m4"), SubResource("WeaponData_p90"), SubResource("WeaponData_krissvector"), SubResource("WeaponData_glock19"), SubResource("WeaponData_fn502"), SubResource("WeaponData_deserteagle"), SubResource("WeaponData_shotgun"), SubResource("WeaponData_sniper")])
ActiveWeaponName = "AK-47"
