[gd_resource type="Resource" script_class="WeaponRegistry" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/data/WeaponRegistry.cs" id="1_registry"]
[ext_resource type="Script" path="res://scripts/data/WeaponData.cs" id="2_weapon"]

[sub_resource type="Resource" id="WeaponData_ak47"]
script = ExtResource("2_weapon")
WeaponName = "AK-47"
WeaponClass = "Assault Rifle"
Description = "Hard-hitting assault rifle with the heaviest kick of the rifles. Best in short, controlled bursts at mid range."
; No "ak" fire clips in the quality_audio pack (its ak/ folder only has bolt sounds) - using
; three of the pack's unlabelled generic rifle-weight shots instead. Swap for something better
; if you find/record an AK-specific one later.
FireMode = 0
BodyDamage = 30.0
HeadshotDamage = 90.0
FireRateRPM = 600.0
MagazineSize = 30
MaxReserveAmmo = 90
ReloadTime = 2.3
RecoilVertical = 3.5
RecoilHorizontal = 2.0
RecoilRecoveryMs = 180.0
ModelScenePath = "res://art/weapons/AssaultRifle/AK47_gun.fbx"
GripPosition = Vector3(0.05, 0.19, 0.02)
GripRotationDegrees = Vector3(-90, -105, 0)
ModelScale = 1.0
MuzzleDistance = 0.55
PelletsPerShot = 1
SpreadDegrees = 0.6
ShellByShellReload = false
FireSounds = PackedStringArray("res://audio/SFX/weapons/generic/fire_09.wav", "res://audio/SFX/weapons/generic/fire_19.wav", "res://audio/SFX/weapons/generic/fire_24.wav")
ReloadSounds = PackedStringArray("res://audio/SFX/weapons/shared/mag_in.wav")
ImpactSounds = PackedStringArray("res://audio/SFX/explosions/explosion.wav")
EmptySound = "res://audio/SFX/weapons/shared/bolt_open.wav"
FireAudioUnitSize = 7.5
FireVolumeDb = 0.0
FireMaxDistanceMeters = 90.0
FireEmissionAngleDegrees = 70.0
FireEmissionOffAxisAttenuationDb = -7.0
FireCanDuckMovement = true
FireReportDelayEnabled = true

[sub_resource type="Resource" id="WeaponData_sniper"]
